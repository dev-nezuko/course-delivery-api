# Copy to .env and adjust. Every value is optional for local development.

# Leave empty in development to get a fresh random key per process.
# Required when DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=

# 1 for development, 0 to turn debug pages off.
DJANGO_DEBUG=1

# Comma-separated host names Django will answer for.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite file location. Defaults to db.sqlite3 next to manage.py.
# The Docker image sets this to /data/db.sqlite3 on a named volume.
# DJANGO_SQLITE_PATH=
